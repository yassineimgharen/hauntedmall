{
	"name": "NightShift",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": { "$path": "src/shared" }
		},
		"ServerScriptService": {
			"Server": { "$path": "src/server" }
		},
		"ServerStorage": {
			"Assets": { "$path": "assets" }
		},
		"StarterPlayer": {
			"$properties": {
				"CameraMaxZoomDistance": 45,
				"CameraMinZoomDistance": 6
			},
			"StarterPlayerScripts": {
				"Client": { "$path": "src/client" }
			}
		},
		"Players": {
			"$properties": {
				"RespawnTime": 5,
				"MaxPlayers": 10
			}
		},
		"Workspace": {
			"$properties": {
				"StreamingEnabled": false
			}
		},
		"Lighting": {
			"$properties": {
				"Technology": "Future",
				"GlobalShadows": true
			}
		},
		"SoundService": {
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
