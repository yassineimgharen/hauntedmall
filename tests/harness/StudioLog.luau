-- Reads the [QA] lines of Studio harness sessions and merges them: which stages were completed, in
-- which mode, and the latest result of every check. Used by scripts/qa-studio-report.luau. A later
-- session replaces an earlier one's result for the same check in the same mode, nothing else.

local StudioLog = {}

export type Result = { Status: string, Name: string, Detail: string, Session: string }
export type Merged = {
	Results: { [string]: { [string]: Result } }, -- mode → check name → latest result
	Complete: { [string]: { [string]: boolean } }, -- mode → "L05 Night" → true
	Version: { [string]: number },
	Notes: { string }, -- disconnects, freezes: evidence, kept in order
}

local STATUSES = { PASS = true, FAIL = true, INCONCLUSIVE = true, SKIPPED = true }

function StudioLog.new(): Merged
	return { Results = {}, Complete = {}, Version = {}, Notes = {} }
end

-- Adds one session's Output text. Timestamps and anything that isn't a [QA] line are ignored.
function StudioLog.add(merged: Merged, session: string, text: string)
	local mode = "Play"
	for line in text:gmatch("[^\r\n]+") do
		local body = line:match("%[QA%] (.+)$")
		if body then
			local version, newMode = body:match("harness version (%d+) starting%. MODE (%a+)")
			if version then
				mode = newMode
				merged.Version[session] = tonumber(version) :: number
			end
			local status, rest = body:match("^(%u+) (.+)$")
			if status and STATUSES[status] then
				local name, detail = rest:match("^(.-) :: (.*)$")
				merged.Results[mode] = merged.Results[mode] or {}
				merged.Results[mode][name or rest] =
					{ Status = status, Name = name or rest, Detail = detail or "", Session = session }
			end
			local key = body:match("^STAGE (.+) COMPLETE$")
			if key then
				merged.Complete[mode] = merged.Complete[mode] or {}
				merged.Complete[mode][key] = true
			end
			if
				body:find("^STOPPED")
				or body:find("^STALL")
				or body:find("^CLIENT SILENT")
				or body:find("^CLIENT%-ERROR")
				or body:find("^CLIENT%-LOCAL froze")
			then
				table.insert(merged.Notes, session .. ": " .. body)
			end
		end
	end
end

local function sortedKeys(map: { [string]: any }): { string }
	local keys = {}
	for key in map do
		table.insert(keys, key)
	end
	table.sort(keys)
	return keys
end

-- levels: the level ids that should be covered. Results are Markdown.
function StudioLog.render(merged: Merged, levels: { string }): string
	local out = {
		"# Studio harness results",
		"",
		"Generated by `scripts/qa-studio-report.luau` from the `[QA]` lines of real Studio sessions. Only sessions listed here are counted, and a stage with no complete run is not verified.",
		"",
		"## Coverage",
		"",
		"| Stage | Run mode (no client) | Play mode (real player) | Fails | Inconclusive |",
		"|---|---|---|---|---|",
	}
	for _, level in levels do
		for _, stage in { "Day", "Night" } do
			local key = level .. " " .. stage
			local fails, unclear = 0, 0
			for _, results in merged.Results do
				for name, result in results do
					if name:sub(1, #key + 1) == key .. ":" then
						fails += if result.Status == "FAIL" then 1 else 0
						unclear += if result.Status == "INCONCLUSIVE" then 1 else 0
					end
				end
			end
			local function done(mode: string): string
				return if merged.Complete[mode] and merged.Complete[mode][key] then "complete" else "**not complete**"
			end
			table.insert(
				out,
				string.format("| %s | %s | %s | %d | %d |", key, done("Server"), done("Play"), fails, unclear)
			)
		end
	end
	for _, section in { { "FAIL", "Failures" }, { "INCONCLUSIVE", "Inconclusive" } } do
		table.insert(out, "")
		table.insert(out, "## " .. section[2])
		table.insert(out, "")
		local any = false
		for _, mode in sortedKeys(merged.Results) do
			for _, name in sortedKeys(merged.Results[mode]) do
				local result = merged.Results[mode][name]
				if result.Status == section[1] then
					any = true
					table.insert(out, string.format("- **%s**, %s (%s): %s", name, mode, result.Session, result.Detail))
				end
			end
		end
		if not any then
			table.insert(out, "None recorded.")
		end
	end
	table.insert(out, "")
	table.insert(out, "## Disconnects and freezes")
	table.insert(out, "")
	if #merged.Notes == 0 then
		table.insert(out, "None recorded.")
	end
	for _, note in merged.Notes do
		table.insert(out, "- " .. note)
	end
	table.insert(out, "")
	return table.concat(out, "\n")
end

return StudioLog
