{
	"name": "NightShiftQA",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			},
			"NightShiftQA": {
				"$path": "tools/studio/NightShiftQA.server.luau"
			}
		},
		"ServerStorage": {
			"Assets": {
				"$path": "assets"
			}
		},
		"StarterPlayer": {
			"$properties": {
				"CameraMaxZoomDistance": 45,
				"CameraMinZoomDistance": 6
			},
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				},
				"NightShiftQAClient": {
					"$path": "tools/studio/NightShiftQAClient.client.luau"
				}
			}
		},
		"Players": {
			"$properties": {
				"RespawnTime": 5,
				"MaxPlayers": 10
			}
		},
		"Workspace": {
			"$properties": {
				"StreamingEnabled": false
			}
		},
		"Lighting": {
			"$properties": {
				"Technology": "Voxel",
				"GlobalShadows": false
			}
		},
		"SoundService": {
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
