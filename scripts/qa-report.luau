-- Turns the result files the specs wrote (build/qa/*.json) into the reports in docs/qa/.
--   .tools/bin/lune run scripts/qa-report.luau       (after running the specs)
-- Every number comes from those files. Nothing here decides what passed.

local fs = require("@lune/fs")
local serde = require("@lune/serde")

local BUGS = {
	L01 = { "BUG-03" },
	L04 = { "BUG-03", "BUG-11" },
	L05 = { "BUG-05" },
	L06 = { "BUG-06", "BUG-08", "BUG-09" },
	L07 = { "BUG-10" },
	L10 = { "BUG-11" },
	L11 = { "BUG-11" },
	L12 = { "BUG-01", "BUG-11" },
	L13 = { "BUG-07", "BUG-11" },
	L14 = { "BUG-10" },
}

-- What this level needs a person (or the Studio harness) to judge: the simulation can't.
local ENGINE_GAPS = {
	L01 = "Customers reaching the till; flashlight beam visuals; the first-time guide arrow on screen.",
	L02 = "Lamps and blackout lighting; crawlers on the balcony stairs and escalators.",
	L03 = "Whether a player can really tell Phantoms by their glitches: a judgement of feel the bots skip (they search blind).",
	L04 = "Camera view UI; crawlers actually reaching the upper terminal by the real pathfinder; alarm lure.",
	L05 = "The keypad UI; laser hit boxes; sneak speed on the client; locker camera; Stalker pathing.",
	L06 = "Shoppers following on real Humanoids, up and down stairs; the van scene; how hard a solo night feels.",
	L07 = "Cannon charge ring triggers; slam and darkness visuals; the real weld of her rig; three phase look.",
	L08 = "Shutter and sign animation; knife volleys against real character hit boxes; cart collisions.",
	L09 = "Fire and foam visuals (ParticleEmitter:Emit on the server replicating); the 10 s solo sprint in real controls.",
	L10 = "UV reveal visuals; mimic pounce fairness at real speed; parcels and nest models; the truck cab prompt.",
	L11 = "Footprint glow under the beam; freeze camera; door animations; heat lamp ranges on screen.",
	L12 = "Rising walls pushing a real character out (the sim only models it); the ramp on real Humanoids; maze readability.",
	L13 = "Crawling the ducts with a real character (headroom, jump); gas fog visuals; meter feel.",
	L14 = "The intro cinematic; cleaver and pan arm motors; dish carry visuals; hit boxes against the real rig.",
}

local suiteSeconds = 0

local function readResults(): ({ any }, { [string]: any })
	local all, notes = {}, {}
	if not fs.isDir("build/qa") then
		error("no build/qa: run the specs first")
	end
	for _, name in fs.readDir("build/qa") do
		if name:match("%.json$") then
			local file = serde.decode("json", fs.readFile("build/qa/" .. name))
			suiteSeconds += file.Seconds or 0
			for _, result in file.Results do
				result.Suite = file.Suite
				table.insert(all, result)
			end
			for key, value in file.Notes or {} do
				notes[key] = value
			end
		end
	end
	return all, notes
end

local results, notes = readResults()
table.sort(results, function(a, b)
	return a.Name < b.Name
end)

local byLevel: { [string]: any } = {}
local general = {}
local passed, failed, skipped = 0, 0, 0
for _, result in results do
	if result.Skipped then
		skipped += 1
	elseif result.Ok then
		passed += 1
	else
		failed += 1
	end
	local id, stage = result.Name:match("^(L%d%d) (%a+):")
	if not id then
		id = result.Name:match("^seed %d+: (L%d%d),")
		stage = "Night"
	end
	if id then
		byLevel[id] = byLevel[id] or { Day = {}, Night = {} }
		table.insert(byLevel[id][stage], result)
	else
		table.insert(general, result)
	end
end

local function counts(list: { any }): (number, number, number)
	local p, f, s = 0, 0, 0
	for _, result in list do
		if result.Skipped then
			s += 1
		elseif result.Ok then
			p += 1
		else
			f += 1
		end
	end
	return p, f, s
end

local function mark(result: any): string
	return if result.Skipped then "skipped" elseif result.Ok then "pass" else "**FAIL**"
end

fs.writeDir("docs/qa/levels")
local table_ = {
	"| Level | Day Tests | Night Tests | Passed | Failed | Bugs Found | Bugs Fixed | Studio Verification |",
	"|---|---|---|---|---|---|---|---|",
}
for i = 1, 14 do
	local id = string.format("L%02d", i)
	local level = byLevel[id] or { Day = {}, Night = {} }
	local dayP, dayF, dayS = counts(level.Day)
	local nightP, nightF, nightS = counts(level.Night)
	local bugs = BUGS[id] or {}
	table.insert(
		table_,
		string.format(
			"| [%s](levels/%s.md) | %d | %d | %d | %d | %d | %d | Not run: needs the Windows laptop |",
			id,
			id,
			dayP + dayF + dayS,
			nightP + nightF + nightS,
			dayP + nightP,
			dayF + nightF,
			#bugs,
			#bugs
		)
	)
	local lines = {
		"# " .. id .. " test report",
		"",
		"Generated by `scripts/qa-report.luau` from the test run. **Highest verification reached: simulated gameplay.** Not run in Roblox Studio.",
		"",
		"Bugs found in this level: "
			.. (if #bugs > 0 then table.concat(bugs, ", ") .. " (fixed, see ../QA_REPORT.md)" else "none"),
		"",
	}
	for _, stage in { "Day", "Night" } do
		table.insert(lines, "## " .. stage)
		table.insert(lines, "")
		table.insert(lines, "| Test | Result | Verification |")
		table.insert(lines, "|---|---|---|")
		for _, result in level[stage] do
			local name = result.Name:gsub("^L%d%d %a+: ", "")
			table.insert(lines, string.format("| %s | %s | %s |", name, mark(result), result.Level))
		end
		table.insert(lines, "")
	end
	local measured = {}
	for key, value in notes do
		if key:sub(1, 4) == id .. "." then
			table.insert(measured, string.format("- %s: %s", key:sub(5), tostring(value)))
		end
	end
	table.sort(measured)
	if #measured > 0 then
		table.insert(lines, "## Measured in the simulation")
		table.insert(lines, "")
		for _, line in measured do
			table.insert(lines, line)
		end
		table.insert(lines, "")
	end
	table.insert(lines, "## Not covered by automation")
	table.insert(lines, "")
	table.insert(lines, ENGINE_GAPS[id] .. " Check these in Studio: see ../STUDIO_HARNESS.md and docs/TESTING.md.")
	table.insert(lines, "")
	fs.writeFile("docs/qa/levels/" .. id .. ".md", table.concat(lines, "\n"))
end

local generalLines = {}
for _, result in general do
	table.insert(generalLines, string.format("| %s | %s | %s |", result.Name, mark(result), result.Level))
end
local gp, gf, gs = counts(general)
local out = {
	"# Latest automated results",
	"",
	"Generated by `scripts/qa-report.luau`. These are simulated or integration results on the real server code in a fake engine. **None of it ran in Roblox.**",
	"",
	table.concat(table_, "\n"),
	"",
	string.format(
		"Totals in these suites: **%d executed: %d passed, %d failed, %d skipped**, %.0f s wall time.",
		passed + failed + skipped,
		passed,
		failed,
		skipped,
		suiteSeconds
	),
	"The older unit specs (Campaign, Chapter2, ShadowQueen, ReceiptProcessor) print their own totals and aren't counted here.",
	"",
	string.format("## Tests not tied to one level: %d passed, %d failed, %d skipped", gp, gf, gs),
	"",
	"| Test | Result | Verification |",
	"|---|---|---|",
	table.concat(generalLines, "\n"),
	"",
}
fs.writeFile("docs/qa/RESULTS.md", table.concat(out, "\n"))
print(string.format("wrote docs/qa: %d passed, %d failed, %d skipped", passed, failed, skipped))
